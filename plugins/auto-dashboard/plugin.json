{
  "id": "auto-dashboard",
  "name": "Automatyczny Dashboard",
  "version": "0.2.2",
  "description": "Sam buduje dashboard ze wszystkich obiektów w rejestrze i udostępnia go w aplikacji vclu na Androida. Zero konfiguracji.",
  "author": "vonxavier",
  "license": "MIT",
  "tags": [
    "dashboard",
    "automatyczny",
    "android"
  ],
  "files": [
    "init.lua"
  ],
  "configSchema": [
    {
      "key": "title",
      "type": "string",
      "label": "Nazwa dashboardu",
      "default": "Dom"
    },
    {
      "key": "remote",
      "type": "boolean",
      "label": "Pokaż w aplikacji (przez chmurę)",
      "default": "true"
    },
    {
      "key": "pin",
      "type": "string",
      "label": "PIN poza domem (puste = bez PIN-u)",
      "description": "Zalecane. Z PIN-em aplikacja poprosi o kod przy wejściu poza domem.",
      "default": ""
    },
    {
      "key": "roles",
      "type": "string",
      "label": "Role z chmury (puste = wszyscy domownicy)",
      "default": ""
    },
    {
      "key": "hideSensitive",
      "type": "boolean",
      "label": "Ukrywaj wrażliwe obiekty poza domem",
      "description": "Obiekty o nazwach z listy poniżej nie będą widoczne w aplikacji.",
      "default": "true"
    },
    {
      "key": "sensitiveWords",
      "type": "string",
      "label": "Słowa wrażliwych obiektów (po przecinku)",
      "default": "BRAMA,GARAZ,ALARM,ZAMEK,DRZWI"
    },
    {
      "key": "hide",
      "type": "string",
      "label": "Ukryj obiekty (fragmenty ścieżek, po przecinku)",
      "description": "Znikają z dashboardu całkowicie, także w domu.",
      "default": ""
    },
    {
      "key": "readonly",
      "type": "string",
      "label": "Poza domem tylko odczyt (fragmenty ścieżek, po przecinku)",
      "default": ""
    },
    {
      "key": "showSensors",
      "type": "boolean",
      "label": "Pokazuj czujniki i odczyty",
      "default": "true"
    },
    {
      "key": "columns",
      "type": "number",
      "label": "Liczba kolumn",
      "default": "3"
    },
    {
      "key": "poll",
      "type": "number",
      "label": "Odświeżanie poza domem (sekundy, min. 2)",
      "default": "5"
    }
  ],
  "config": {
    "title": {
      "type": "string",
      "default": "Dom"
    },
    "remote": {
      "type": "boolean",
      "default": true
    },
    "pin": {
      "type": "string",
      "default": ""
    },
    "roles": {
      "type": "string",
      "default": ""
    },
    "hideSensitive": {
      "type": "boolean",
      "default": true
    },
    "sensitiveWords": {
      "type": "string",
      "default": "BRAMA,GARAZ,ALARM,ZAMEK,DRZWI"
    },
    "hide": {
      "type": "string",
      "default": ""
    },
    "readonly": {
      "type": "string",
      "default": ""
    },
    "showSensors": {
      "type": "boolean",
      "default": true
    },
    "columns": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 6
    },
    "poll": {
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 60
    }
  }
}