{
  "id": "blebox",
  "name": "BleBox",
  "version": "0.1.1",
  "description": "BleBox (API switchBox): lokalne HTTP, wykrywanie po id urzadzenia, polling, most do DOUT z OM",
  "tags": ["blebox", "switchbox", "relay", "local"],
  "files": ["init.lua"],

  "configSchema": [
    {
      "key": "subnet",
      "type": "string",
      "label": "Podsiec do skanowania (3 pierwsze oktety)",
      "description": "np. 192.168.1 - plugin sprawdzi adresy od rangeFrom do rangeTo",
      "default": "192.168.1"
    },
    {
      "key": "rangeFrom",
      "type": "number",
      "label": "Skan od (ostatni oktet)",
      "default": "1"
    },
    {
      "key": "rangeTo",
      "type": "number",
      "label": "Skan do (ostatni oktet)",
      "default": "254"
    },
    {
      "key": "hosts",
      "type": "string",
      "label": "Reczne adresy IP (opcjonalnie, po przecinku)",
      "description": "Sprawdzane przed skanem podsieci, np. 192.168.1.18,192.168.1.19"
    },
    {
      "key": "interval",
      "type": "number",
      "label": "Odpytywanie stanu (sekundy)",
      "default": "2"
    },
    {
      "key": "enableBridge",
      "type": "boolean",
      "label": "Most do DOUT (OM) wlaczony",
      "default": "true"
    },
    {
      "key": "bindings",
      "type": "string",
      "label": "Powiazania przekaznik -> DOUT",
      "description": "Format: id:przekaznik=sciezka;  np. ee64c9c7496d:0=CLU.DOU5048;ee64c9c7496d:1=CLU.DOU4458"
    },
    {
      "key": "rescanCooldown",
      "type": "number",
      "label": "Minimalny odstep miedzy skanami (sekundy)",
      "default": "30"
    },
    {
      "key": "scanConcurrency",
      "type": "number",
      "label": "Rownolegle zapytania podczas skanu",
      "default": "10"
    }
  ],

  "exports": {
    "objects": {
      "status": {"type": "BleBoxStatus"}
    },
    "events": [
      {"name": "blebox:changed", "description": "Zmiana stanu przekaznika: {id, relay, state}"}
    ]
  },

  "docs": [
    {"title": "README", "file": "README.md"}
  ]
}
